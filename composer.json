{
  "name": "nextcloud/shortlinks",
  "description": "Privacy-preserving short link management for Nextcloud",
  "license": "AGPL-3.0-or-later",
  "authors": [{"name": "Shortlinks Contributors"}],
  "autoload": {"psr-4": {"OCA\\Shortlinks\\": "lib/"}},
  "autoload-dev": {
    "psr-4": {
      "OCA\\Shortlinks\\Tests\\Unit\\": "tests/unit/",
      "OCP\\": "vendor/nextcloud/ocp/OCP/"
    }
  },
  "scripts": {
    "post-install-cmd": ["@composer bin all install --ansi"],
    "post-update-cmd": ["@composer bin all install --ansi"],
    "lint": "@php scripts/lint.php",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "psalm": "psalm --threads=1 --no-cache",
    "test:unit": "phpunit tests/unit -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
    "test:integration": "phpunit tests/integration -c tests/phpunit.xml --colors=always",
    "openapi": "generate-spec",
    "test:security": ["@composer audit", "@composer psalm"],
    "test:all": ["@composer lint", "@composer cs:check", "@composer psalm", "@composer test:unit", "@composer test:integration"]
  },
  "require": {
    "endroid/qr-code": "^6.0",
    "geoip2/geoip2": "^3.2",
    "matomo/device-detector": "^6.4",
    "php": ">=8.3 <=8.5"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "roave/security-advisories": "dev-latest"
  },
  "config": {
    "allow-plugins": {"bamarni/composer-bin-plugin": true},
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {"php": "8.3.0"},
    "platform-check": false
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": false
    }
  }
}
